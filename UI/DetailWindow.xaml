<Window x:Class="AIMeter.UI.DetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" MaxHeight="760" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F2F2F4" Background="#FF1B1B20"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,20">
            <!-- Account header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="10" Height="10" Fill="{Binding AccentBrush}" Margin="0,8,10,0" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ManageSubtitle}" FontSize="12" Foreground="#9A9AA3" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="8" Padding="9,3,9,4" Margin="10,4,0,0" VerticalAlignment="Top"
                        Background="{Binding PlanBackground}" Visibility="{Binding PlanVisibility}">
                    <TextBlock Text="{Binding Plan}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                </Border>
            </Grid>

            <!-- Account facts -->
            <Grid Margin="20,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Status" FontSize="12" Foreground="#85858E" Margin="0,0,16,4" />
                <TextBlock Grid.Column="1" FontSize="12" Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding Status}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                                    <Setter Property="Text" Value="—" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Row="1" Text="Last checked" FontSize="12" Foreground="#85858E" Margin="0,0,16,0" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdatedText}" FontSize="12" />
            </Grid>

            <!-- Usage windows -->
            <TextBlock Text="Usage" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,0" />
            <TextBlock Text="No usage data yet." Visibility="{Binding NoMetersVisibility}" FontSize="12" Foreground="#9A9AA3" Margin="0,8,0,0" />
            <ItemsControl ItemsSource="{Binding Meters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,10,0,0" Padding="14,12,14,12" CornerRadius="10" Background="#12FFFFFF">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                                    <TextBlock Text="{Binding RemainingText}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding BarBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Height="8" Margin="0,8,0,0">
                                    <Border CornerRadius="4" Background="#22FFFFFF" />
                                    <Border CornerRadius="4" Background="{Binding BarBrush}" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Fraction}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Used" FontSize="12" Foreground="#85858E" Margin="0,0,16,3" />
                                    <TextBlock Grid.Column="1" Text="{Binding UsedText}" FontSize="12" Margin="0,0,0,3" />
                                    <TextBlock Grid.Row="1" Text="Left" FontSize="12" Foreground="#85858E" Margin="0,0,16,3" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LeftText}" FontSize="12" Margin="0,0,0,3" />
                                    <TextBlock Grid.Row="2" Text="Resets" FontSize="12" Foreground="#85858E" Margin="0,0,16,3" Visibility="{Binding ResetVisibility}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Margin="0,0,0,3" TextWrapping="Wrap" Visibility="{Binding ResetVisibility}">
                                        <Run Text="{Binding ResetAtText, Mode=OneWay}" /><Run Text=" · " Foreground="#85858E" /><Run Text="{Binding ResetInText, Mode=OneWay}" Foreground="#B8B8C0" />
                                    </TextBlock>
                                    <TextBlock Grid.Row="3" Text="Spend" FontSize="12" Foreground="#85858E" Margin="0,0,16,0" Visibility="{Binding DetailVisibility}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap" Visibility="{Binding DetailVisibility}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Notes}" Visibility="{Binding NotesVisibility}" FontSize="12" Foreground="#A0A0AA" TextWrapping="Wrap" Margin="0,12,0,0" />

            <StackPanel Visibility="{Binding ErrorVisibility}" Margin="0,12,0,0">
                <TextBlock Text="{Binding Error}" FontSize="12" Foreground="#F28B82" TextWrapping="Wrap" />
                <Button Style="{StaticResource PillButton}" Content="Sign in again" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Visibility="{Binding SignInVisibility}" Click="SignInAgain_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Style="{StaticResource PillButton}" Content="Refresh" Click="Refresh_Click" />
                <Button Style="{StaticResource PillButton}" Content="Close" Margin="8,0,0,0" Click="Close_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
