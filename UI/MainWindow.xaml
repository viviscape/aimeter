<Window x:Class="AIMeter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI Meter" Width="336" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="#F2F2F4"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Border Margin="8" CornerRadius="14" Background="#FF1B1B20" BorderBrush="#30FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" />
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Refresh now" Click="Refresh_Click" />
                <MenuItem Header="Accounts &amp; settings…" Click="Settings_Click" />
                <MenuItem x:Name="TopmostMenu" Header="Always on top" IsCheckable="True" Click="Topmost_Click" />
                <Separator />
                <MenuItem Header="Hide widget" Click="Hide_Click" />
                <MenuItem Header="Exit AI Meter" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>

        <StackPanel Margin="14,8,10,14">
            <!-- Header (drag handle) -->
            <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="#D97757" VerticalAlignment="Center" Margin="0,1,7,0" />
                    <TextBlock Text="AI Meter" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpdatedText" FontSize="11" Foreground="#85858E" VerticalAlignment="Center" Margin="8,1,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh now" Click="Refresh_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Accounts &amp; settings" Click="Settings_Click" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Hide (reopen from the tray icon)" Click="Hide_Click" />
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyPanel" Margin="0,14,4,4">
                <TextBlock Text="No accounts yet" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="Sign in to the Claude and ChatGPT/Codex accounts you want to watch." FontSize="12" Foreground="#9A9AA3" TextWrapping="Wrap" Margin="0,4,0,10" />
                <Button Style="{StaticResource PillButton}" Content="Add an account" HorizontalAlignment="Left" Click="Settings_Click" />
            </StackPanel>

            <!-- Accounts -->
            <ItemsControl x:Name="AccountsList" Margin="0,0,4,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,10,0,0" Padding="12,10,12,10" CornerRadius="10" Background="#12FFFFFF">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{Binding AccentBrush}" Margin="0,6,9,0" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8F8F98" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="2" CornerRadius="8" Padding="8,2,8,3" Margin="8,0,0,0" VerticalAlignment="Top"
                                            Background="{Binding PlanBackground}" Visibility="{Binding PlanVisibility}">
                                        <TextBlock Text="{Binding Plan}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding AccentBrush}" />
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Meters}" Margin="0,2,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,9,0,0">
                                                <Grid>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#D6D6DC" />
                                                    <TextBlock Text="{Binding RemainingText}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding BarBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid Height="6" Margin="0,5,0,0">
                                                    <Border CornerRadius="3" Background="#22FFFFFF" />
                                                    <Border CornerRadius="3" Background="{Binding BarBrush}" RenderTransformOrigin="0,0.5">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Fraction}" />
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding SubText}" FontSize="10.5" Foreground="#80808A" Margin="0,4,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Notes}" Visibility="{Binding NotesVisibility}" FontSize="11" Foreground="#A0A0AA" TextWrapping="Wrap" Margin="0,8,0,0" />

                                <StackPanel Visibility="{Binding ErrorVisibility}" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Error}" FontSize="11" Foreground="#F28B82" TextWrapping="Wrap" />
                                    <Button Style="{StaticResource PillButton}" Content="Sign in again" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding SignInVisibility}" Tag="{Binding}" Click="SignInAgain_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
