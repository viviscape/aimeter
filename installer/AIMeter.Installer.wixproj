<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!-- Folder holding the self-contained AIMeter.exe produced by build\build-installer.ps1 -->
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\app\</PublishDir>
    <OutputName>AIMeter-$(Version)-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>Version=$(Version);PublishDir=$(PublishDir);AssetsDir=$(MSBuildThisFileDirectory)..\assets\</DefineConstants>
    <!-- ICE validation needs the Windows Installer service; leave it on unless building in a container. -->
    <SuppressValidation Condition="'$(SuppressIces)' == 'true'">true</SuppressValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
