<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AIMeter</AssemblyName>
    <RootNamespace>AIMeter</RootNamespace>
    <Product>AI Meter</Product>
    <Version>1.1.0</Version>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Company>ViviScape</Company>
    <Description>Claude and Codex usage widget</Description>
    <ApplicationIcon>assets\AIMeter.ico</ApplicationIcon>
    <DefaultItemExcludes>$(DefaultItemExcludes);installer\**;artifacts\**;publish\**;build\**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
